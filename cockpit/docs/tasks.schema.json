{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://remote-pi.dev/cockpit/tasks.schema.json",
  "title": "Cockpit Task Run config",
  "description": "Schema for .cockpit/tasks.json — see cockpit/docs/tasks-json.md",
  "type": "object",
  "required": ["tasks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "cwd": {
      "type": "string",
      "description": "Default cwd for every task (relative to the file folder). Each task can override."
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["label", "command"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "description": "Short name shown in the list." },
        "command": { "type": "string", "description": "Base executable (npm, flutter, go...)." },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Base args, before the profile."
        },
        "cwd": {
          "type": "string",
          "description": "Working directory relative to the tasks.json folder (or absolute). Omitted = top-level default / root."
        },
        "platforms": {
          "oneOf": [
            { "$ref": "#/$defs/platform" },
            { "type": "array", "items": { "$ref": "#/$defs/platform" } }
          ],
          "description": "OSes where the task is visible (macos, windows, linux). Omitted = all."
        },
        "kind": {
          "enum": ["watch", "oneShot"],
          "default": "oneShot",
          "description": "watch = live process (dev-server); oneShot = runs and exits."
        },
        "interactiveKeys": {
          "type": "array",
          "items": { "$ref": "#/$defs/interactiveKey" }
        },
        "watch": { "$ref": "#/$defs/watch" },
        "progressPatterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/progressPattern" }
        },
        "profiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/profile" }
        },
        "preview": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string", "format": "uri" }
          ],
          "default": true,
          "description": "Browser auto-open: true (default) opens the first local URL from output; false turns it off; a string opens that fixed URL at start."
        },
        "previewOpen": {
          "enum": ["always", "start", "never"],
          "default": "always",
          "description": "When the preview opens: always (default, start and restart), start (start only — restart does not reopen), never."
        }
      }
    },
    "platform": { "enum": ["macos", "windows", "linux"] },
    "interactiveKey": {
      "type": "object",
      "required": ["key", "label"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "description": "Sequence written to the PTY (e.g. r, R, q)." },
        "label": { "type": "string" },
        "icon": { "enum": ["refresh", "restart", "stop", "bolt"] },
        "primary": { "type": "boolean", "default": false }
      }
    },
    "watch": {
      "type": "object",
      "required": ["onChange"],
      "additionalProperties": false,
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" } },
        "ignore": { "type": "array", "items": { "type": "string" } },
        "onChange": {
          "type": "string",
          "description": "label of an interactiveKey, or '__restart__'."
        },
        "debounceMs": { "type": "integer", "minimum": 0, "default": 300 }
      }
    },
    "progressPattern": {
      "type": "object",
      "required": ["begin", "end"],
      "additionalProperties": false,
      "properties": {
        "begin": { "type": "string", "description": "Regex for start of recompilation." },
        "end": { "type": "string", "description": "Regex for return to idle." }
      }
    },
    "profile": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
