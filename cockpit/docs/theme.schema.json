{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/jacobaraujo7/remote_pi/main/cockpit/docs/theme.schema.json",
  "title": "Cockpit theme",
  "description": "Schema for a Cockpit theme — see cockpit/docs/theme-format.md",
  "type": "object",
  "required": ["id", "name", "variants"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "description": "Stable namespaced identity (publisher.name). This is what preferences store. Must not collide with a built-in: cockpit, cockpit.2, violet, violet.2, midnight, rose, sun, flexoki, pantera.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "description": "Name shown in the theme picker.",
      "minLength": 1
    },
    "author": { "type": "string" },
    "version": { "type": "string" },
    "extends": {
      "type": "string",
      "description": "Id of a built-in theme to inherit undeclared tokens from. Absent = inherit from the 'cockpit' theme.",
      "enum": ["cockpit", "cockpit.2", "violet", "violet.2", "midnight", "rose", "sun", "flexoki", "pantera"]
    },
    "variants": {
      "type": "object",
      "description": "At least one of dark/light. A theme with only one variant is applied at both brightnesses.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "dark": { "$ref": "#/definitions/variant" },
        "light": { "$ref": "#/definitions/variant" }
      }
    }
  },

  "definitions": {
    "color": {
      "type": "string",
      "description": "CSS hex: #RGB, #RRGGBB or #RRGGBBAA (alpha at the END).",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },

    "variant": {
      "type": "object",
      "description": "The three palettes for one brightness. Every token is optional: missing ones come from the base.",
      "additionalProperties": false,
      "properties": {
        "ui": { "$ref": "#/definitions/ui" },
        "syntax": { "$ref": "#/definitions/syntax" },
        "terminal": { "$ref": "#/definitions/terminal" }
      }
    },

    "ui": {
      "type": "object",
      "description": "App interface tokens.",
      "additionalProperties": false,
      "properties": {
        "bg": { "$ref": "#/definitions/color", "description": "Deepest app background." },
        "panel": { "$ref": "#/definitions/color", "description": "Pane / rail surface." },
        "panel2": { "$ref": "#/definitions/color", "description": "Elevated: composer, cards." },
        "panel3": { "$ref": "#/definitions/color", "description": "Hover / inline code." },

        "border": { "$ref": "#/definitions/color", "description": "Hairline." },
        "border2": { "$ref": "#/definitions/color", "description": "Stronger divider." },

        "text": { "$ref": "#/definitions/color", "description": "Primary text." },
        "text2": { "$ref": "#/definitions/color", "description": "Secondary text." },
        "text3": { "$ref": "#/definitions/color", "description": "Tertiary / placeholder." },
        "text4": { "$ref": "#/definitions/color", "description": "Weak: idle icon." },

        "accent": { "$ref": "#/definitions/color", "description": "Brand color. Text on it is derived from luminance, not a token." },
        "accentSoft": { "$ref": "#/definitions/color", "description": "Selection background — translucent." },
        "accentText": { "$ref": "#/definitions/color", "description": "Text in the brand color." },

        "online": { "$ref": "#/definitions/color" },
        "ok": { "$ref": "#/definitions/color" },
        "error": { "$ref": "#/definitions/color" },
        "warn": { "$ref": "#/definitions/color" },

        "edited": { "$ref": "#/definitions/color", "description": "Highlight for a recently edited file." },
        "editedBg": { "$ref": "#/definitions/color" },

        "gitStaged": { "$ref": "#/definitions/color" },
        "gitUntracked": { "$ref": "#/definitions/color" },
        "gitDeleted": { "$ref": "#/definitions/color" },
        "gitConflict": { "$ref": "#/definitions/color" },

        "scrim": { "$ref": "#/definitions/color", "description": "Dialog backdrop — translucent." },
        "shadow": { "$ref": "#/definitions/color", "description": "Drop shadow — translucent." }
      }
    },

    "syntax": {
      "type": "object",
      "description": "Code-viewer highlighting.",
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/definitions/color" },
        "base": { "$ref": "#/definitions/color", "description": "Unscoped text." },
        "comment": { "$ref": "#/definitions/color" },
        "keyword": { "$ref": "#/definitions/color" },
        "string": { "$ref": "#/definitions/color" },
        "number": { "$ref": "#/definitions/color" },
        "class": { "$ref": "#/definitions/color", "description": "Types / classes." },
        "builtin": { "$ref": "#/definitions/color" },
        "function": { "$ref": "#/definitions/color" },
        "variable": { "$ref": "#/definitions/color" },
        "meta": { "$ref": "#/definitions/color", "description": "Decorators / preprocessor." },
        "deletion": { "$ref": "#/definitions/color", "description": "Diff -." }
      }
    },

    "terminal": {
      "type": "object",
      "description": "Terminal ANSI palette.",
      "additionalProperties": false,
      "properties": {
        "cursor": { "$ref": "#/definitions/color" },
        "selection": { "$ref": "#/definitions/color" },
        "foreground": { "$ref": "#/definitions/color" },
        "background": { "$ref": "#/definitions/color" },

        "black": { "$ref": "#/definitions/color" },
        "red": { "$ref": "#/definitions/color" },
        "green": { "$ref": "#/definitions/color" },
        "yellow": { "$ref": "#/definitions/color" },
        "blue": { "$ref": "#/definitions/color" },
        "magenta": { "$ref": "#/definitions/color" },
        "cyan": { "$ref": "#/definitions/color" },
        "white": { "$ref": "#/definitions/color" },

        "brightBlack": { "$ref": "#/definitions/color" },
        "brightRed": { "$ref": "#/definitions/color" },
        "brightGreen": { "$ref": "#/definitions/color" },
        "brightYellow": { "$ref": "#/definitions/color" },
        "brightBlue": { "$ref": "#/definitions/color" },
        "brightMagenta": { "$ref": "#/definitions/color" },
        "brightCyan": { "$ref": "#/definitions/color" },
        "brightWhite": { "$ref": "#/definitions/color" },

        "searchHitBackground": { "$ref": "#/definitions/color" },
        "searchHitBackgroundCurrent": { "$ref": "#/definitions/color" },
        "searchHitForeground": { "$ref": "#/definitions/color" }
      }
    }
  }
}
